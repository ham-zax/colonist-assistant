{
  "name": "colonist-assistant",
  "version": "0.9.2",
  "packageManager": "bun@1.3.13",
  "private": true,
  "type": "module",
  "description": "Explainable, board-aware guidance for friendly Colonist games.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:arena": "node scripts/build-arena.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "benchmark:colonist": "node scripts/benchmark-colonist.mjs",
    "benchmark:catanatron": "python3 scripts/benchmark-catanatron.py",
    "benchmark:local": "node scripts/benchmark-local.mjs",
    "benchmark:checkpoint": "node scripts/read-arena-checkpoint.mjs",
    "train:model": "python3 scripts/train-strategic-model.py",
    "train:trade": "python3 scripts/train-trade-model.py",
    "train:expert": "node scripts/run-expert-iteration.mjs",
    "replay:decisions": "node scripts/replay-decisions.mjs",
    "verify:rust": "node scripts/verify-rust.mjs",
    "verify": "bun run check && bun run test && bun run verify:rust && bun run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/jsdom": "^28.0.3",
    "esbuild": "^0.25.8",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
